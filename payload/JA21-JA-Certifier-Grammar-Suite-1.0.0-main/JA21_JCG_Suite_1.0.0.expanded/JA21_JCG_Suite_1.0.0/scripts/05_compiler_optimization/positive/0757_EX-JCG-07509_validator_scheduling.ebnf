ja certifier 0.3
module corpus.ja_certifier.example_07509
policy no_execute_unknown_code
policy no_network
grammar Grammar07509 {
  production E = E, "+", T | T ;
  production T = T, "*", F | F ;
  production F = IDENT | "(", E, ")" ;
}
normalize grammar Grammar07509 using [eliminate_left_recursion, factor_prefixes, compute_first_follow, build_automaton, compress_tables]
analyze ambiguity Grammar07509
lower certificate Grammar07509 to JA_CERTIFIER_R12
