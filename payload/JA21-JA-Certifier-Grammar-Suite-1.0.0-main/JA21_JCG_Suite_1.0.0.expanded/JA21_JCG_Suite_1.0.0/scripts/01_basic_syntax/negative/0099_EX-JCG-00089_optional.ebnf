ja certifier 0.3
module corpus.ja_certifier.example_00089
policy no_execute_unknown_code
policy no_network
grammar Grammar00089 {
  token IDENT = letter, { letter | digit | "_" } ;
  token NUMBER = digit, { digit } ;
  production atom = IDENT | NUMBER | "(", expression, ")" ;
  production expression = atom, { ("+" | "-"), atom } ;
  start expression ;
}
certify grammar Grammar00089 profile basic
assert certificate.semantic_hash == "invalid-00089"
